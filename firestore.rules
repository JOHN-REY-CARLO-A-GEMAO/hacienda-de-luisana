rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Bookings collection
    // - Anyone can CREATE a booking (guest inquiry form)
    // - Only authenticated users can READ/UPDATE/DELETE (owner dashboard)
    // - Validate required fields on create
    match /bookings/{bookingId} {
      allow create: if true
        && request.resource.data.keys().hasAll(['guest_name','phone','email','check_in','check_out','guests','accommodation','status','created_at'])
        && request.resource.data.guest_name is string && request.resource.data.guest_name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.check_in is string
        && request.resource.data.check_out is string
        && request.resource.data.status == 'Pending';

      allow read, update, delete: if isSignedIn();

      // For tighter security, uncomment to restrict to specific owner emails:
      // allow read, update, delete: if isSignedIn() && request.auth.token.email in ['owner@example.com'];
    }

    // Future collections examples:

    // Gallery images metadata (public read, owner write)
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Site config (public read, owner write)
    match /site_config/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Deny all other collections by default unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
