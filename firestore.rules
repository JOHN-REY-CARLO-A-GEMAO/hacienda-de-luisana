rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is authenticated (includes Firebase anonymous uid)
    function isSignedIn() {
      return request.auth != null;
    }

    // P3: admin = owner allowlist only (keep in sync with storage.rules
    // isOwnerEmail + site.ts contact email). Anonymous uids have no email
    // token, so guests can never satisfy this — they use isOwnDoc().
    // Owner login: Google sign-in with haciendadeluisiana@gmail.com in /admin.
    function ownerEmails() {
      return ['haciendadeluisiana@gmail.com'];
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in ownerEmails();
    }

    // Role split: anak = locks-readonly placeholder.
    // SWAP 1 LINE when the real Gmail arrives (no code change, redeploy only).
    function anakEmails() {
      return ['gemaojohnreycarloarguilles@gmail.com'];
    }

    // Anak may READ bookings (to make sense of lock records) + READ
    // access_logs. No create/update/delete anywhere, no KYC, no confirm.
    function isAnak() {
      return isSignedIn() && request.auth.token.email in anakEmails();
    }

    // P2: guest owns docs carrying their anon uid.
    function isOwnDoc() {
      return isSignedIn()
        && resource.data.get('uid', '') != ''
        && resource.data.get('uid', '') == request.auth.uid;
    }

    // Bookings collection (shared by web /book + Flutter app, P2/P3)
    // - CREATE stays public pending-only so web inquiry works unauthenticated.
    //   Extra app keys (ref_id, uid, kyc_status, kyc urls, source,
    //   eta_share_url) are additive.
    // - READ: owner full + anak (locks-readonly) + guest read-own (anon uid).
    // - UPDATE/DELETE: owner only + guest self-serve below. Anak can NEVER
    //   approve/cancel — update/delete exclude isAnak() on purpose.
    //   Host MUST re-check availability at approve time (G2), and the system
    //   re-checks it for them: see src/lib/booking (forApproval).
    match /bookings/{bookingId} {
      allow create: if true
        && request.resource.data.keys().hasAll(['guest_name','phone','email','check_in','check_out','guests','accommodation','status','created_at'])
        && request.resource.data.guest_name is string && request.resource.data.guest_name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.check_in is string
        && request.resource.data.check_out is string
        && request.resource.data.status == 'Pending';

      allow read: if isAdmin() || isAnak() || isOwnDoc();

      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.get('uid', '') == request.auth.uid
          && resource.data.status in ['Pending', 'KYC Submitted']
          // A Guest may withdraw, upload or resend their ID and payment proof,
          // and choose a payment plan. They may never approve or verify
          // anything themselves (ADR-0001: money moves only after the Host).
          && request.resource.data.status in ['Pending', 'KYC Submitted', 'Payment Pending', 'Cancelled']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'kyc_status', 'kyc_id_url', 'kyc_receipt_url', 'kyc_reject_reason',
                      'eta_share_url', 'payment_plan', 'payment_status', 'payment_proof_url',
                      'amount_claimed', 'stay_total', 'amount_due', 'security_deposit',
                      'balance_due', 'cancellation_reason', 'hold_expires_at']));

      allow delete: if isAdmin();

      // Activity log (spec #9, ticket #11): the append-only record of every
      // state change, with the actor and timestamp that made it.
      // - CREATE: anyone who may change the Booking, with the entry shape.
      // - READ: owner + anak + the Guest it belongs to.
      // - UPDATE/DELETE: nobody. Not the owner. An audit record that can be
      //   edited is not an audit record (CONTEXT.md § Activity log).
      match /activity/{entryId} {
        allow create: if request.resource.data.keys().hasAll(
            ['booking_id', 'action', 'from_status', 'to_status', 'actor', 'actor_id', 'at'])
          && request.resource.data.booking_id == bookingId;
        allow read: if isAdmin() || isAnak() || isOwnDoc();
        allow update, delete: if false;
      }
    }

    // Smart-lock access logs (P4 Central DB sync target).
    // Shape: {timestamp, uid, ref_id, result: granted|denied, reason}.
    // - CREATE: any signed-in client (guest app / lock gateway, incl. anon)
    //   with the exact shape — append-only telemetry, no PII beyond uid.
    // - READ: owner full + anak locks-readonly (admin lock-records view).
    // - UPDATE/DELETE: owner only (tamper-evident history).
    match /access_logs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['timestamp','uid','ref_id','result','reason'])
        && request.resource.data.result in ['granted', 'denied'];
      allow read: if isAdmin() || isAnak();
      allow update, delete: if isAdmin();
    }

    // Gallery images metadata (public read, owner write)
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site config (public read, owner write)
    match /site_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny all other collections by default unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
