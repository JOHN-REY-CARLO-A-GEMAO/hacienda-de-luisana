rules_version = '2';

// ============================================================================
// Hacienda de LuisAna — Firestore authorization
// ============================================================================
// This file is the enforcement. Everything in `src/` is a courtesy: a page that
// hides a button, a lifecycle that refuses an action, a form that will not
// submit. A person who opens the browser console and calls Firestore directly
// bypasses all of that and lands here.
//
// Two roles, from CONTEXT.md § People, each with its own application
// (ADR-0007):
//
//   Guest — books and stays, on the website. Reads and changes their own
//           Booking, sends their own ID and payment proof, shares their own
//           location. Sees nothing of anybody else's.
//   Admin — operates the hacienda, from the Flutter mobile app. Everything:
//           reviews Bookings, reads IDs, verifies payments, refunds, records
//           check-in/out and completion, deletes, reads the Access log,
//           publishes rates.
//
// There is no Staff role and no Host role. A role is *stored*, not claimed:
// `profiles/{uid}` holds one of the two, and `role()` below reads it.
// `src/lib/auth` (web) and `lib/services/auth_store.dart` (app) resolve a role
// in exactly this order, so a screen never offers what this file is about to
// refuse. See ADR-0005 and ADR-0007.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Who is asking
    // ------------------------------------------------------------------

    // Helper: is authenticated (includes Firebase anonymous uid)
    function isSignedIn() {
      return request.auth != null;
    }

    // A Guest's own document: it carries the identity attached when it was
    // created (ADR-0004), and that key is never among the ones they may change.
    function isOwnDoc() {
      return isSignedIn()
        && resource.data.get('uid', '') != ''
        && resource.data.get('uid', '') == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // Roles
    // ------------------------------------------------------------------

    // The bootstrap allowlist: the Admin addresses, which carry the role with
    // no Profile written, so a deployment can never be locked out of itself by
    // a missing document. Kept in step with BOOTSTRAP_ROLES in
    // src/lib/auth/profile.ts, isAdminEmail() in storage.rules and
    // AuthStore.kAdminEmails in lib/services/auth_store.dart.
    // Anonymous uids carry no email claim, so a Guest can never satisfy it.
    function adminEmails() {
      return ['haciendadeluisiana@gmail.com', 'gemaojohnreyarguilles@gmail.com'];
    }

    function profileOf(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    // A stored role that is not one of the two is no role at all, and reads as
    // Guest: a document nobody can explain must not grant anything. The retired
    // 'host' and 'staff' values fall here too — the Admin is recognised by the
    // allowlist, or by a Profile that says 'admin'.
    function knownRole(value) {
      return value in ['guest', 'admin'] ? value : 'guest';
    }

    // The role a Profile stores. No Profile is a Guest, so a signed-in person
    // with nothing written down holds the fewest permissions, not the most.
    // One `exists()` and one `get()`, and only for a request that got this far.
    function storedRole() {
      return isSignedIn() && exists(profileOf(request.auth.uid))
        ? knownRole(get(profileOf(request.auth.uid)).data.get('role', 'guest'))
        : 'guest';
    }

    // The email claim, or null. An anonymous token carries no `email` key at
    // all, and reading a missing key is an evaluation *error* in the rules
    // runtime — not a false. Written as a bare `request.auth.token.email`, the
    // rule below would refuse every anonymous Guest by crashing rather than by
    // deciding, which is indistinguishable from a policy denial and cannot be
    // asserted against. So the claim is read in the order that survives a
    // missing one: present, then not null, then read.
    function tokenEmail() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email != null
        ? request.auth.token.email
        : null;
    }

    // The role of this request, in the order src/lib/auth uses: the bootstrap
    // allowlist, then the Profile, then Guest. Somebody signed out is 'none',
    // which matches no role and therefore no rule below.
    function role() {
      return !isSignedIn() ? 'none'
        : (tokenEmail() in adminEmails()) ? 'admin'
        : storedRole();
    }

    function isAdmin() {
      return role() == 'admin';
    }

    // Guest advance-booking policy, in the existing Admin-owned site_config.
    // This document is the authoritative setting for both clients and rules.
    // The fallback mirrors MINIMUM_BOOKING_LEAD_TIME_DAYS in booking/leadTime.ts.
    function minimumBookingLeadTimeDays() {
      let defaultDays = 30;
      let policy = /databases/$(database)/documents/site_config/booking;
      let days = exists(policy)
        ? get(policy).data.get('minimumBookingLeadTimeDays', defaultDays)
        : defaultDays;
      return days is int && days > 0 ? days : defaultDays;
    }

    function validBookingPolicy() {
      // Preserve other Admin-owned settings/metadata on this document. Only
      // the new field is constrained; an absent field uses the shared default.
      return !request.resource.data.keys().hasAny(['minimumBookingLeadTimeDays'])
        || (request.resource.data.minimumBookingLeadTimeDays is int
            && request.resource.data.minimumBookingLeadTimeDays > 0);
    }

    function meetsMinimumBookingLeadTime(checkIn) {
      let parts = checkIn.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let date = timestamp.date(year, month, day);
      // request.time is trusted server time. Asia/Manila is UTC+08:00 with
      // no DST. Shift BEFORE truncating to a date to avoid UTC off-by-one days.
      let today = (request.time + duration.value(8, 'h')).date();
      return date.year() == year && date.month() == month && date.day() == day
        && date >= today + duration.value(minimumBookingLeadTimeDays(), 'd');
    }

    // ------------------------------------------------------------------
    // The two invariants the rule layer has to hold on its own
    // ------------------------------------------------------------------
    // A Booking's money is claimed by the Guest and verified by the Admin
    // (ADR-0001). The lifecycle modules — `src/lib/booking` on the web,
    // `lib/services/booking_lifecycle.dart` in the app — are the application's
    // copy of that rule, and a client that talks to Firestore directly never
    // loads them. These two functions are the enforcement's copy:

    // A document that says `payment_status: 'verified'` must carry the marker
    // that makes the claim checkable — an amount above zero, an instant, and
    // the verifier's own uid. The verifier is the person making the write: a
    // console cannot sign another Admin's name to a verification, and the
    // fixture fields the Guest may write can never produce this marker.
    function hasVerificationMarker() {
      return request.resource.data.get('amount_verified', 0) > 0
        && request.resource.data.get('payment_verified_at', '') != ''
        && request.resource.data.get('payment_verified_by', '') == request.auth.uid;
    }

    // `Reserved` is the status verified money *buys* on a historical booking.
    // `Approved` is the confirmation a downpayment screenshot buys (ADR-0012):
    // the Admin accepts the proof, and the same write verifies the money.
    // No writer may reach either status with the money unverified.
    function reservedIsPaidFor() {
      return request.resource.data.get('status', resource.data.get('status', '')) != 'Reserved'
        || request.resource.data.get('payment_status', '') == 'verified';
    }

    // Approved is earned, not typed. It may be written only from Pending, and
    // only when the resulting document carries the screenshot plus the
    // verification marker. A Booking that is already Approved may stay there.
    function approvedIsEarned() {
      return request.resource.data.get('status', '') != 'Approved'
        || resource.data.get('status', '') == 'Approved'
        || (resource.data.get('status', '') == 'Pending'
            && request.resource.data.get('payment_proof_url', '') is string
            && request.resource.data.get('payment_proof_url', '').size() > 0
            && request.resource.data.get('payment_status', '') == 'verified'
            && hasVerificationMarker());
    }

    // ------------------------------------------------------------------
    // Profiles — who has which role
    // ------------------------------------------------------------------
    // Who is the Admin rests on this collection (and the allowlist), so it is
    // the one place that has to be impossible to talk into a lie:
    //   - you may write your own Profile, but only as a Guest;
    //   - the Admin may write anybody's, with one of the two roles;
    //   - nobody may write a role that is not one of the two.
    match /profiles/{userId} {

      // A Profile carries its own uid, one of the two roles, and nothing else:
      // a document that arrives with extra keys is refused rather than stored and
      // wondered about later.
      function isProfileShape() {
        return request.resource.data.uid == userId
          && request.resource.data.role in ['guest', 'admin']
          && request.resource.data.keys()
               .hasOnly(['uid', 'role', 'email', 'display_name', 'created_at', 'updated_at',
                         'phone', 'birthdate', 'terms_version', 'terms_accepted_at']);
      }

      // Your own Profile, and everybody's if you are the Admin.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Signing up writes this, and a sign-up is always a Guest. The Admin may
      // open a Profile for somebody whose sign-up did not leave one.
      allow create: if isProfileShape()
        && ((isSignedIn() && request.auth.uid == userId && request.resource.data.role == 'guest')
            || isAdmin());

      // The Admin decides roles. A person may correct their own name and address,
      // but never their own role — that is the one field this collection exists
      // to keep out of their hands.
      allow update: if isProfileShape()
        && (isAdmin()
            || (isSignedIn() && request.auth.uid == userId
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['display_name', 'email', 'updated_at', 'phone', 'birthdate',
                               'terms_version', 'terms_accepted_at'])));

      // Removing an account's role. Never your own: one click should not be able
      // to leave the hacienda with no Admin signed in.
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // ------------------------------------------------------------------
    // Bookings (shared by web /book, /account and the Flutter app — P2/P3)
    // ------------------------------------------------------------------
    // - CREATE stays public pending-only so a web inquiry works unauthenticated.
    //   Extra app keys (ref_id, uid, source, eta_share_url, paymentProofUrl,
    //   extractedRefNumber) are additive.
    // - READ: own (the identity attached at creation), and the Admin.
    // - UPDATE: the Admin anything within the guard-rails below; a Guest their
    //   own self-serve keys. DELETE: the Admin.
    //   The Admin MUST re-check availability at approve time (G2), and the app
    //   re-checks it for them: see lib/services/booking_lifecycle.dart.
    match /bookings/{bookingId} {
      allow create: if true
        && request.resource.data.keys().hasAll(['guest_name','phone','email','check_in','check_out','guests','accommodation','status','created_at','payment_proof_url','payment_status','amount_claimed'])
        && request.resource.data.guest_name is string && request.resource.data.guest_name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.check_in is string
        && request.resource.data.check_out is string
        // Guest/public creates obey the lead time; only a backend-resolved
        // Admin may create a manual booking sooner. No existing update/action
        // is gated, including review of previously submitted bookings.
        && (isAdmin() || (request.resource.data.check_in.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                         && meetsMinimumBookingLeadTime(request.resource.data.check_in)))
        && request.resource.data.status == 'Pending'
        && request.resource.data.get('uid', '') != ''
        // ADR-0012: a Booking is born Pending, and only with a downpayment
        // screenshot attached. It cannot arrive Approved, Rejected, or already
        // verified — those are the Admin's decision, made later.
        && request.resource.data.payment_proof_url is string
        && request.resource.data.payment_proof_url.size() > 0
        && request.resource.data.payment_status == 'pending'
        && request.resource.data.amount_claimed is number
        && request.resource.data.amount_claimed > 0
        && request.resource.data.get('amount_verified', 0) == 0
        && request.resource.data.get('payment_verified_by', '') == ''
        && request.resource.data.get('payment_verified_at', '') == '';

      // Cheapest check first: a Guest reading their own Booking should not pay
      // for a Profile read to find out they are allowed.
      allow read: if isOwnDoc() || isAdmin();

      allow update: if reservedIsPaidFor() && (
        // The Admin's writes are checked at the rule layer for the moves that
        // must never go wrong: nothing leaves a terminal status, the money
        // gates cannot be skipped — Payment Pending needs the Admin's approval
        // (from a Booking still under review), Reserved needs verified money
        // (the invariant above) — and a Booking can never be left saying
        // `verified` without the marker that says who verified it. The full
        // lifecycle table lives in lib/services/booking_lifecycle.dart (app)
        // and src/lib/booking (web).
        (isAdmin()
          && approvedIsEarned()
          && !(resource.data.status in ['Rejected', 'Cancelled', 'Completed', 'Expired']
               && request.resource.data.status != resource.data.status)
          // Retired statuses are read as their successors (Confirmed →
          // Reserved, KYC Submitted → Pending) and are never written again.
          // `Approved` is written again: it is the confirmation (ADR-0012).
          && !(request.resource.data.status in ['Confirmed', 'KYC Submitted'])
          && !(request.resource.data.status == 'Payment Pending'
               && !(resource.data.status in ['Pending', 'KYC Submitted', 'Approved', 'Payment Pending']))
          && !(request.resource.data.status == 'Reserved'
               && resource.data.status != 'Payment Pending')
          && (request.resource.data.get('payment_status', '') != 'verified'
              || hasVerificationMarker())
          // The verifier named on the document is whoever wrote it, or the name
          // already recorded there — never a third party.
          && (request.resource.data.get('payment_verified_by', '')
                == resource.data.get('payment_verified_by', '')
              || request.resource.data.get('payment_verified_by', '') == request.auth.uid))

        // A Guest may withdraw, choose a payment plan, and upload or resend
        // a payment proof — and stamp the cancellation policy their plan was
        // quoted under. They may never approve or verify anything
        // themselves (ADR-0001: money moves only after the Admin), and never
        // touch the identity the Booking was created with. No location key is
        // legitimate on a Booking either: live tracking was removed entirely
        // (ADR-0009), so a position written here is refused like any other
        // unknown key.
        || (isSignedIn()
          && resource.data.get('uid', '') == request.auth.uid
          // Forward or out, never backwards: a Guest may take their own Booking
          // to the next stage the lifecycle gives them, or withdraw it, but can
          // never write a status that un-does a decision the Admin already made.
          // (`KYC Submitted` and `Approved` still appear as *stored* statuses on
          // documents written before KYC was removed; they are retired on read.)
          && ((resource.data.status in ['Pending', 'KYC Submitted']
                 && request.resource.data.status in ['Pending', 'Cancelled'])
              || (resource.data.status == 'Approved'
                 && request.resource.data.status in ['Approved', 'Cancelled'])
              || (resource.data.status == 'Payment Pending'
                 && request.resource.data.status in ['Payment Pending', 'Cancelled'])
              || (resource.data.status == 'Reserved'
                 && request.resource.data.status in ['Reserved', 'Cancelled']))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status',
                      'payment_plan', 'payment_status', 'payment_proof_url', 'paymentProofUrl',
                      'payment_reject_reason', 'extractedRefNumber',
                      'amount_claimed', 'stay_total', 'amount_due', 'security_deposit',
                      'balance_due', 'cancellation_reason', 'hold_expires_at',
                      'refund_status', 'refund_total', 'refund_breakdown',
                      'policy_version', 'policy_effective_date',
                      'payment_reference', 'ocr_reference', 'ocr_amount',
                      'terms_version', 'terms_accepted_at'])
          // Money moves in one direction only, and only into the Guest's own
          // words: `unpaid` -> `pending` by sending a proof. `verified`,
          // `approved` and `rejected` are the Admin's — a Guest may not claim
          // them, and may not un-do one the Admin already wrote (a verified
          // Booking cannot be pushed back to `pending` to submit a different
          // proof).
          && (request.resource.data.get('payment_status', 'unpaid') in ['unpaid', 'pending']
              || request.resource.data.get('payment_status', '') == resource.data.get('payment_status', ''))
          // The Admin's notes are the Admin's words. A Guest may clear one only
          // by attaching a fresh proof in the same write — the resubmit loop
          // — and can never write a note of their own.
          && (request.resource.data.get('payment_reject_reason', '') == resource.data.get('payment_reject_reason', '')
              || (request.resource.data.get('payment_reject_reason', '') == null
                  && request.resource.data.get('payment_proof_url', '') != resource.data.get('payment_proof_url', '')))
          // A Guest who withdraws a paid Reservation records what the published
          // policy says comes back (the settlement is computed once, in
          // `src/lib/booking/money.ts` / `booking_lifecycle.dart`, and reaches
          // the database as a patch). What a Guest may *not* do is invent money:
          // the refund can never exceed the amount the Admin actually verified,
          // the breakdown has to agree with the total, and `refunded` — the fact
          // that money went back — is the Admin's to record.
          && request.resource.data.get('refund_status', resource.data.get('refund_status', 'none')) in ['none', 'initiated']
          && request.resource.data.get('refund_total', 0) is number
          && request.resource.data.get('refund_total', 0) >= 0
          && request.resource.data.get('refund_total', 0)
               <= request.resource.data.get('amount_verified', resource.data.get('amount_verified', 0))
          // Guarded on presence rather than defaulted: `{}` is not a map the
          // runtime will hand back here, and asking a value that is not there
          // for a key is an evaluation error rather than a false. A Guest who
          // withdraws without a breakdown agrees with themselves and passes.
          && (!request.resource.data.keys().hasAny(['refund_breakdown'])
              || request.resource.data.refund_breakdown.get('refundTotal', request.resource.data.get('refund_total', 0))
                   == request.resource.data.get('refund_total', 0)))
      );

      allow delete: if isAdmin();

      // Who owns this Booking, read from the Booking itself and never from the
      // entry: an Activity entry carries no `uid` of its own and the app writes
      // none, so `isOwnDoc()` — which reads `resource.data` — could never be true
      // down here, and the Guest a Booking belongs to was refused its own audit
      // trail. `src/lib/firestoreBookings.ts` reads the log to pick the next
      // sequence number before it appends, so that refusal was not cosmetic: every
      // Guest append failed on the read and degraded to localStorage, leaving the
      // Admin an empty log on every Booking a Guest had submitted. Asking the
      // parent also settles the other half — nothing here compared the parent to
      // the writer, so a Guest could file entries into somebody else's Booking.
      function isOwnBooking() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/bookings/$(bookingId))
          && get(/databases/$(database)/documents/bookings/$(bookingId))
               .data.get('uid', '') == request.auth.uid;
      }

      // Activity log (spec #9, ticket #11): the append-only record of every
      // state change, with the actor and timestamp that made it.
      // - CREATE: the Guest it belongs to, or the Admin, each naming themselves
      //   truthfully.
      // - READ: the Admin, and the Guest it belongs to.
      // - UPDATE/DELETE: nobody. Not the Admin. An audit record that can be
      //   edited is not an audit record (CONTEXT.md § Activity log).
      match /activity/{entryId} {
        // The names an entry may carry. A Guest may file an entry into their
        // own Booking and nothing more — the actor checks below already stop
        // them signing anybody else's name, but without this list they could
        // file one reading "Payment proof verified — Booking Reserved" in
        // their own name, which is a lie in the one log the Admin reads. The
        // first fifteen are the Booking lifecycle's own vocabulary
        // (`src/lib/booking/actions.ts` and `lib/services/booking_lifecycle.dart`
        // spell them identically); the last five are a Review's (ADR-0014).
        function knownAction() {
          return request.resource.data.action in [
            'Submit', 'Approve', 'Reject', 'ChoosePaymentPlan', 'UploadPaymentProof',
            'VerifyPayment', 'RejectPaymentProof', 'MarkRefunded', 'RevokeKey',
            'Cancel', 'Expire', 'CheckIn', 'BeginStay', 'CheckOut', 'Complete',
            'SetStatus',
            'ReviewSubmitted', 'ReviewUpdated', 'AdminReviewResponded',
            'ReviewModerated', 'ReviewPublished'
          ];
        }

        allow create: if request.resource.data.keys().hasAll(
            ['booking_id', 'action', 'from_status', 'to_status', 'actor', 'actor_id', 'at'])
          && knownAction()
          && request.resource.data.booking_id == bookingId
          // An entry has to be written in the name of whoever is writing it —
          // both the role *and* the uid. An audit log that lets a Guest file an
          // entry naming another Guest, or sign the Admin's name to an approval,
          // is worse than no log at all.
          && request.resource.data.actor_id != ''
          && ((request.resource.data.actor == 'guest'
               && request.resource.data.actor_id == request.auth.uid
               // …and into their own Booking only. Without this a Guest who knew
               // or guessed another Guest's booking id could add noise to that
               // Booking's audit trail, since nothing else here reads the parent.
               && isOwnBooking())
              // An Admin-signed entry names the Admin writing it.
              || (request.resource.data.actor == 'admin' && isAdmin()
                  && request.resource.data.actor_id == request.auth.uid)
              // A Date hold running out is the system's doing, recorded by the
              // Admin app's screen that saw it (ADR-0002) — the one entry that
              // belongs to nobody.
              || (request.resource.data.actor == 'system' && isAdmin()
                  && request.resource.data.actor_id == 'system')
              // The public inquiry path: a Booking made without any identity
              // (Anonymous sign-in disabled). There is nobody to impersonate
              // there, so the only entry it may write is the submission itself.
              || (!isSignedIn()
                  && request.resource.data.actor == 'guest'
                  && request.resource.data.action == 'Submit'));
        allow read: if isOwnBooking() || isAdmin();
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // Smart-lock Access logs (P4 Central DB sync target)
    // ------------------------------------------------------------------
    // Shape: {timestamp, uid, ref_id, result: granted|denied, reason}.
    // - CREATE: any signed-in client (guest app / lock gateway, incl. anon)
    //   with the exact shape, in their own name: the uid is the writer's, so
    //   a row is attributable. That matters because a granted row is the
    //   Admin's check-in cue — a row written in somebody else's uid is a cue
    //   about the wrong person.
    // - READ: the Admin (the Smart Lock screen of the app).
    // - UPDATE/DELETE: the Admin only (tamper-evident history).
    match /access_logs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['timestamp','uid','ref_id','result','reason'])
        && request.resource.data.result in ['granted', 'denied']
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Gallery images metadata (public read, Admin write)
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site config — including the published rates at site_config/rates that
    // the app's Rates screen writes (public read, Admin write).
    match /site_config/{docId} {
      allow read: if true;
      allow write: if isAdmin()
        && (docId != 'booking' || request.resource == null || validBookingPolicy());
    }

    // The retired tracking module's collection (ADR-0009). Superseded for
    // *reading and writing a position* by ADR-0013, which puts live location in
    // the conversation instead — but this collection stays closed, because what
    // ADR-0009 was right about has not changed: a position written to Firestore
    // is a position stored forever, and the module that wrote it had no expiry
    // anyone could enforce. A document left over from before the withdrawal can
    // still be cleared:
    // - READ / CREATE / UPDATE: refused to every caller, the Admin included.
    // - DELETE: the Admin only.
    // Live location today writes no position to Firestore at all. See
    // `location_sessions` below for what it does keep, and database.rules.json
    // for the stream it does not store. Door events are logged in access_logs;
    // a position never belongs there.
    match /tracking_sessions/{sessionId} {
      allow read, create, update: if false;
      allow delete: if isAdmin();
    }

    // The reference catalogue the Admin's verification checks a proof against.
    // An entry that has been used is evidence — which reference paid for which
    // stay — so it can be voided but not rewritten or deleted, or the same
    // reference could be quietly re-used for a second Booking.
    match /payment_references/{refId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['reference', 'amount', 'status'])
        && request.resource.data.status in ['available', 'used', 'void'];
      allow update: if isAdmin()
        && request.resource.data.keys().hasAll(['reference', 'amount', 'status'])
        && request.resource.data.status in ['available', 'used', 'void']
        && request.resource.data.reference == resource.data.reference
        && request.resource.data.amount == resource.data.amount;
      // Only a reference nothing has ever paid with may be removed. A `used`
      // entry is evidence of which reference paid for which stay, and voiding
      // it does not stop that being evidence — so `void` is kept as well as
      // `used`. `!= 'used'` here would have let the Admin void a used reference
      // and then delete the record of it, which is the one outcome the comment
      // above this collection exists to refuse.
      allow delete: if isAdmin() && resource.data.get('status', '') == 'available';
    }

    // A conversation belongs to exactly one Guest, and only that Guest (or the
    // Admin) can reach it. Knowing a conversation id is not a membership: the
    // rule reads the conversation's own `guest_uid` and compares it with the
    // caller, and the Admin is the allowlist/Profile role, nothing weaker.
    function conversationDoc(convoId) {
      return /databases/$(database)/documents/conversations/$(convoId);
    }

    function isConversationMember(convoId) {
      return isSignedIn()
        && exists(conversationDoc(convoId))
        && get(conversationDoc(convoId)).data.get('guest_uid', '') == request.auth.uid;
    }

    match /conversations/{convoId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['guest_uid', 'category', 'created_at', 'updated_at'])
        && request.resource.data.guest_uid == request.auth.uid
        // A Guest may not open their own thread with an expiry already on it.
        && !request.resource.data.keys().hasAny(['messages_expires_at']);
      // READ — the Admin, and the Guest the conversation belongs to, plus one
      // more case that is not a way in at all.
      //
      // A Guest opening a thread has to ask "is there one here yet?", and a
      // `getDoc` on a document that does not exist is refused by
      // `isConversationMember` — there is no document to be a member of. So the
      // client could not tell "no thread yet" from "not yours", and the chat page
      // answered "Could not open the conversation." instead of opening one.
      //
      // `!exists(...)` grants a read only where there is nothing to read. It
      // reveals nothing about anybody else's data: an id that belongs to another
      // Guest still exists, still fails membership, and is still refused. All a
      // caller learns is that an id it invented itself is unused — which it
      // already knew. This is the difference between "denied" and "absent", and
      // it is what lets a thread be opened without a collection scan:
      // `ensureConversation` used to find the thread with a `where` query, which
      // the rules cannot prove safe for this collection, so `conversationDocId`
      // derives the id instead.
      allow read: if isAdmin()
        || isConversationMember(convoId)
        || !exists(conversationDoc(convoId));
      // Neither side may re-point a conversation at a different Guest: that
      // would hand one Guest's history to another.
      //
      // `messages_expires_at` is the retention stamp (docs/MESSAGING.md § 4):
      // only the Admin writes it, so a Guest can neither shorten the window on a
      // thread the hacienda is keeping nor put an expiry on a live one.
      allow update: if request.resource.data.get('guest_uid', '') == resource.data.get('guest_uid', '')
        && (isAdmin()
            || (isConversationMember(convoId)
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['updated_at', 'last_message', 'unread_admin', 'unread_guest'])));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        // - CREATE: a member of *this* conversation, signing their own uid. A
        //   stranger who learns the conversation id cannot post into it, and
        //   nobody can post as somebody else. The role label has to match what
        //   the writer actually is, so a Guest cannot mark their message as the
        //   Admin's.
        // - LENGTH: 1,000 characters, the same figure as `MESSAGE_MAX` in
        //   `src/lib/validation.ts`. It is written out here on purpose: a
        //   browser can be told anything, and what a page read of a thread costs
        //   is decided by the rule, not by the form that produced the message.
        // - READ: the Admin, and the Guest whose conversation it is.
        // - UPDATE/DELETE: nobody. Chat is a record, not a canvas.
        //
        // The two branches are written out separately, deliberately: a Guest's
        // branch never reads the Admin's token claim, so a Guest is judged on the
        // conversation's own `guest_uid` alone and the rule does not depend on
        // how a missing claim behaves.
        allow create: if request.resource.data.keys().hasAll(['sender_uid', 'sender_role', 'text', 'created_at'])
          && request.resource.data.sender_uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && ((request.resource.data.sender_role == 'guest' && isConversationMember(convoId))
              || (request.resource.data.sender_role == 'admin' && isAdmin()));
      allow read: if isAdmin() || isConversationMember(convoId);
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // Live location — the session, not the position (ADR-0013)
    // ------------------------------------------------------------------
    // A Guest may share their live position from inside a conversation. What
    // lands in Firestore is this one document, and it carries no coordinate: who
    // is sharing, since when, until when, and the random secret that ties the
    // ephemeral stream to this consent. The document id IS the conversation id,
    // so `isConversationMember(sessionId)` is the membership check — the same
    // one the messages in that conversation already answer to, and a Guest who
    // has not opened a session here is not asked to pass a second test.
    //
    // The position itself never comes here. It is published to a Realtime
    // Database node carrying a server-side TTL, which the server deletes whether
    // or not the Guest ever presses Stop. A rule can refuse a write; it cannot
    // schedule a deletion, so the expiry here is enforced three ways instead:
    // the create below caps the window, the Admin's reader compares `expires_at`
    // against the clock, and the stream's own rules refuse a write past it.
    match /location_sessions/{sessionId} {
      // CREATE — the Guest of *this* conversation, opening a session for
      // themselves. The window is 1..60 minutes and is checked against the
      // clock, so a client cannot claim a year of sharing.
      allow create: if isConversationMember(sessionId)
        && request.resource.data.keys().hasAll([
             'guest_uid', 'conversation_id', 'active', 'started_at',
             'expires_at', 'duration_minutes', 'stream_secret'])
        && request.resource.data.guest_uid == request.auth.uid
        && request.resource.data.conversation_id == sessionId
        && request.resource.data.active == true
        && request.resource.data.duration_minutes is int
        && request.resource.data.duration_minutes >= 1
        && request.resource.data.duration_minutes <= 60
        && request.resource.data.stream_secret is string
        && request.resource.data.stream_secret.size() == 32
        && request.resource.data.started_at is timestamp
        && request.resource.data.expires_at is timestamp
        && request.resource.data.expires_at > request.time
        && request.resource.data.expires_at <= request.time + duration.value(1, 'h')
        // The rule that keeps the feature honest: this document is metadata, and
        // a coordinate written here would be a position stored forever. There is
        // no shape of position this accepts.
        && !request.resource.data.keys().hasAny([
             'lat', 'lng', 'latitude', 'longitude', 'position', 'fix', 'points', 'trail']);

      // READ — the Admin, and the Guest who is sharing, so a page reload can
      // resume the countdown instead of starting a second session. Nobody else:
      // a Guest is not a member of another Guest's conversation, and this rule
      // is the only door to the metadata.
      allow read: if isAdmin() || isConversationMember(sessionId);

      // UPDATE — the same Guest ending their own session. Only `active` and
      // `expires_at` may move, and once ended it cannot be reopened: the
      // identity, the conversation and the secret are fixed for the life of the
      // document, because those are what the stream is bound to.
      allow update: if isConversationMember(sessionId)
        && resource.data.guest_uid == request.auth.uid
        && request.resource.data.guest_uid == resource.data.guest_uid
        && request.resource.data.conversation_id == resource.data.conversation_id
        && request.resource.data.stream_secret == resource.data.stream_secret
        && request.resource.data.duration_minutes == resource.data.duration_minutes
        && !(resource.data.active == false && request.resource.data.active == true)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['active', 'expires_at']);

      // DELETE — the Admin, or the Guest clearing their own session.
      allow delete: if isAdmin()
        || (isConversationMember(sessionId) && resource.data.guest_uid == request.auth.uid);
    }

    // A Review is a Guest's words about their own finished stay, and one stay
    // gets one of them. The document id *is* the Booking id, so that is the
    // shape of the store rather than a check somebody has to remember to run,
    // and the rule can read the Booking the Review claims to be about and make
    // the three facts the app makes as well: that it is the author's Booking,
    // that the stay is over, and that no second Review can be filed for it.
    match /reviews/{reviewId} {
      function bookingReviewed() {
        return /databases/$(database)/documents/bookings/$(reviewId);
      }

      // 1..5, or absent. Never 0: a category the Guest skipped is missing, and
      // a zero would be read as the worst rating available rather than as no
      // answer.
      function rated(field) {
        return !request.resource.data.keys().hasAny([field])
          || (request.resource.data.get(field, 0) is int
              && request.resource.data.get(field, 0) >= 1
              && request.resource.data.get(field, 0) <= 5);
      }

      function categoriesOk() {
        return rated('cleanliness') && rated('accommodation')
            && rated('communication') && rated('value');
      }

      // The written part is optional, and if it is there it is words: not
      // empty, not nothing but spaces, and no longer than the Guest could
      // have typed — the same 1,000 as MESSAGE_MAX, which is the same 1,000
      // the website's REVIEW_MAX refuses before it gets here.
      function textOk() {
        return !request.resource.data.keys().hasAny(['text'])
          || (request.resource.data.get('text', '') is string
              && request.resource.data.get('text', '').size() > 0
              && request.resource.data.get('text', '').size() <= 1000
              && !request.resource.data.get('text', '').matches('\\s*'));
      }

      // Exactly the keys a Guest may write. A create arriving already
      // carrying a status, an Admin's reply or a moderation stamp is refused
      // rather than stored and argued about afterwards.
      function guestWritable() {
        return request.resource.data.keys()
                 .hasOnly(['booking_id', 'uid', 'stars', 'created_at', 'text', 'status',
                           'cleanliness', 'accommodation', 'communication', 'value',
                           'edit_until']);
      }

      allow create: if isSignedIn()
        && request.resource.data.keys()
             .hasAll(['booking_id', 'uid', 'stars', 'created_at', 'status', 'edit_until'])
        && guestWritable()
        && request.resource.data.booking_id == reviewId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && textOk()
        && categoriesOk()
        // A Review lands `pending` and waits for the Admin. The website has
        // always told the Guest it is "saved for Admin review", and nobody
        // arrives on the public page already published — least of all by
        // writing the status themselves.
        && request.resource.data.status == 'pending'
        // The fortnight in which the Guest may still correct it. The value is
        // not the Guest's to pick: the rule bounds it against its own clock, so
        // a console cannot stamp an edit window that ends next year. Bounded
        // rather than equal, because `request.time` is the commit instant and
        // no client can compute `edit_until` from it — asking for equality
        // would make the create impossible to satisfy at all.
        && request.resource.data.edit_until is timestamp
        && request.resource.data.edit_until > request.time
        && request.resource.data.edit_until <= request.time + duration.value(14, 'd')
        && exists(bookingReviewed())
        && get(bookingReviewed()).data.get('uid', '') == request.auth.uid
        && get(bookingReviewed()).data.get('status', '') in ['Checked-Out', 'Completed'];

      // READ — the Admin, and the Guest who wrote it. A Review is the Guest's
      // own words about their own stay: nobody else's, and no signed-out
      // visitor's. What the website publishes is a different document; see
      // `public_reviews` below.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.get('uid', '') == request.auth.uid);

      // UPDATE — two doors, because these are two different permissions.
      allow update: if (
        // The Guest correcting their own words, inside the fortnight the
        // create stamped. Identity, status and the window itself are not among
        // the keys that may move, so a Guest cannot reopen a hidden Review,
        // un-hide one, or move their own deadline.
        isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.time < resource.data.edit_until
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['stars', 'text', 'cleanliness', 'accommodation',
                       'communication', 'value', 'updated_at'])
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && textOk()
        && categoriesOk()
      ) || (
        // The Admin moderating, and answering. The Guest's words are NOT among
        // the keys the Admin may change either: an Admin who dislikes a rating
        // hides it — which the Activity log records — rather than rewriting it
        // to five stars.
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'published_at', 'moderated_at', 'moderated_by',
                       'admin_response', 'admin_response_at', 'admin_response_by'])
        && (request.resource.data.get('status', resource.data.get('status', 'pending'))
             in ['pending', 'published', 'hidden'])
        // A reply stamped with somebody else's uid is a reply nobody wrote, and
        // the Activity log already refuses to be signed that way — so this
        // collection refuses it for the same reason and by the same test.
        && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin_response_by'])
            ? request.resource.data.admin_response_by == request.auth.uid
            : true)
        && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderated_by'])
            ? request.resource.data.moderated_by == request.auth.uid
            : true)
      );

      // DELETE — the Admin, and only the Admin. A Guest does not get to take a
      // rating back by deleting it; hiding a Review they dislike is the Admin's
      // decision to make out loud, and it is the moderation log's entry.
      allow delete: if isAdmin();
    }

    // What a visitor to the website reads (ADR-0014).
    //
    // Not a view of `reviews`, and not a copy pruned afterwards: a separate
    // document the Admin writes, out of a Review, choosing which words go out
    // and under whose name. The Review carries the author's uid, the Booking it
    // is about and the Admin's private reply — and a uid is a key back to a
    // Booking that holds a name, an email and a phone number. So this document
    // is six named fields written from scratch and `hasOnly` says so, which is
    // what makes the next field somebody adds safe by default: it cannot reach
    // the public page unless it is named here.
    //
    // Presence here IS publication. There is no `status` field: the Admin
    // withdraws a testimonial by deleting it, so there is no window in which a
    // document is half-public, and a signed-out visitor can list the whole
    // collection without having to ask whether any given document is meant to
    // be seen — everything in here is.
    match /public_reviews/{reviewId} {
      function publicShape() {
        return request.resource.data.keys()
                 .hasOnly(['review_id', 'stars', 'excerpt', 'display_name', 'month', 'published_at'])
          && request.resource.data.review_id == reviewId
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5
          && request.resource.data.excerpt is string
          && request.resource.data.excerpt.size() > 0
          && request.resource.data.excerpt.size() <= 400
          && request.resource.data.display_name is string
          && request.resource.data.display_name.size() > 0
          && request.resource.data.display_name.size() <= 60
          && request.resource.data.month is string
          && request.resource.data.month.size() > 0;
      }

      allow read: if true;
      allow create: if isAdmin() && publicShape();
      // Replacing a published testimonial means deleting it and writing it
      // again: one write, one Activity entry, no half-public state in between.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Rooms + guest CRM (operations reference data, seeded by the Admin).
    // No public writer: the Admin reads and writes. Until seeded, the app
    // shows its local reference copy.
    match /rooms/{roomId} {
      allow read, write: if isAdmin();
    }

    match /guest_profiles/{profileId} {
      allow read, write: if isAdmin();
    }

    // Deny all other collections by default unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
