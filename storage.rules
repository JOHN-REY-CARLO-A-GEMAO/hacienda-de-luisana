rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // The Admin, by the bootstrap allowlist (ADR-0005, ADR-0007).
    //
    // Deliberately NOT the `profiles/{uid}` role that firestore.rules reads:
    // Storage rules would have to reach into Firestore to see it, and the only
    // people who need an Admin Storage grant are the allowlisted addresses that
    // sign into the mobile app. The Admin-only reads that matter — a Guest's
    // government ID under /kyc and payment proof under /payments — are keyed by
    // uid and opened here by the same allowlist. If a promoted Admin (Profile
    // role 'admin', not on the allowlist) ever needs Storage, this becomes the
    // place to teach Storage about Profiles.
    // Keep these addresses in sync with adminEmails() in firestore.rules,
    // BOOTSTRAP_ROLES in src/lib/auth/profile.ts and AuthStore.kAdminEmails in
    // lib/services/auth_store.dart.
    function isAdminEmail() {
      return isSignedIn()
        && request.auth.token.email in ['haciendadeluisiana@gmail.com', 'gemaojohnreycarloarguilles@gmail.com'];
    }

    // Public read for site assets, Admin-only write (site images are
    // Admin-published).
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminEmail()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /accommodations/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminEmail()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // User avatars (only the person themselves can write their own)
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024;
    }

    // P3 ENABLED: KYC ID + receipt uploads (sensitive PII, RA10173).
    // Layout: /kyc/{uid}/{bookingRef}/{id|receipt}.jpg
    // - WRITE own-uid only, 5MB, image/* (guest uploads own docs only).
    // - READ own uid + the Admin allowlist (Admin review in the mobile app).
    //   No public read.
    // - Deletes/overwrites follow the same write gate (resubmit loop), with
    //   one exception: the Admin deletes on PurgeKyc, within 30 days after the
    //   stay (the ID's purpose ended at approval). A delete carries no
    //   resource, and that is the only tell Storage rules have — so the
    //   Admin's write grant admits deletes and nothing else: an uploaded ID is
    //   still the Guest's alone to write.
    match /kyc/{userId}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdminEmail());
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow write: if isAdminEmail() && request.resource == null;
    }

    // P4 ENABLED (#14): payment proof uploads (screenshots/receipts of money
    // sent outside the system — GCash / bank transfer, ADR-0001).
    // Layout: /payments/{uid}/{bookingRef}/proof.jpg
    // - WRITE own-uid only, 5MB, image/* (guest uploads own proof only).
    // - READ own uid + the Admin allowlist (Admin verification in the mobile
    //   app). No public read.
    // - Deletes follow the same gate as /kyc: the Admin deletes on request, which
    //   carries no resource (request.resource == null).
    match /payments/{userId}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdminEmail());
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow write: if isAdminEmail() && request.resource == null;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
