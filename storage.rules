rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // P3: owner allowlist (same address as firestore isAdmin).
    // Keep in sync with firestore.rules OWNER_EMAILS.
    function isOwnerEmail() {
      return isSignedIn()
        && request.auth.token.email in ['haciendadeluisiana@gmail.com'];
    }

    // Role split: anak = locks-readonly placeholder (SWAP 1 LINE when the
    // real Gmail arrives — same address as firestore anakEmails).
    // Anak gets NO storage grants beyond public reads: /kyc holds gov IDs
    // (PII, RA10173) and stays owner-only on purpose. Anak reads lock
    // records from Firestore access_logs, never from Storage.
    function anakEmails() {
      return ['gemaojohnreycarloarguilles@gmail.com'];
    }

    function isAnak() {
      return isSignedIn()
        && request.auth.token.email in anakEmails();
    }

    // Public read for site assets, owner-only write (tightened P3:
    // was any-signed-in; site images are owner-published).
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isOwnerEmail()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /accommodations/{allPaths=**} {
      allow read: if true;
      allow write: if isOwnerEmail()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // User avatars (only owner can write own)
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024;
    }

    // P3 ENABLED: KYC ID + receipt uploads (sensitive PII, RA10173).
    // Layout: /kyc/{uid}/{bookingRef}/{id|receipt}.jpg
    // - WRITE own-uid only, 5MB, image/* (guest uploads own docs only).
    // - READ own uid + owner allowlist (host review). Anak is BLOCKED
    //   from IDs (locks-readonly ≠ ID review) — isAnak() deliberately
    //   absent here. No public read.
    // - Deletes/overwrites follow the same write gate (resubmit loop).
    match /kyc/{userId}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isOwnerEmail());
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
