rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // The bootstrap Admin, by email allowlist (ADR-0005, ADR-0007). Site assets
    // and legacy payment proofs below keep that existing boundary. Private
    // message images additionally recognize a promoted Admin through the stored
    // `profiles/{uid}` role in isMessageAdmin()/canAccessMessageImages().
    // Neither path grants public attachment access.
    // The claim is read defensively, in the same order as tokenEmail() in
    // firestore.rules: an anonymous token has no `email` key, and touching it
    // is an evaluation error rather than a false.
    // Keep these addresses in sync with adminEmails() in firestore.rules,
    // BOOTSTRAP_ROLES in src/lib/auth/profile.ts and AuthStore.kAdminEmails in
    // lib/services/auth_store.dart.
    function isAdminEmail() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email != null
        && request.auth.token.email in ['gemaojohnreyarguilles@gmail.com'];
    }

    // Public read for site assets, Admin-only write (site images are
    // Admin-published).
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminEmail()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /accommodations/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminEmail()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ------------------------------------------------------------------
    // Private Guest ↔ Admin message images.
    //
    // Separate from public site images and anonymous payment-proof uploads.
    // Storage receives the same Firebase Auth token as Firestore. These two
    // cross-service reads resolve the actual conversation and, only when
    // needed, the caller's stored Admin role. `get` of a missing conversation
    // errors and denies; no public read or shareable download token is needed.
    // ------------------------------------------------------------------
    function messageConversation(convoId) {
      return /databases/(default)/documents/conversations/$(convoId);
    }

    function messageProfile(uid) {
      return /databases/(default)/documents/profiles/$(uid);
    }

    function isMessageAdmin() {
      return isSignedIn()
        && (isAdminEmail()
            || firestore.get(messageProfile(request.auth.uid)).data.get('role', 'guest') == 'admin');
    }

    function canAccessMessageImages(convoId) {
      // Do not write this as `get(...).guest_uid == uid || isAdmin()`: CEL can
      // resolve `error || true` to true, which would let an Admin manufacture a
      // path for a missing conversation. The ternaries make the missing get()
      // fatal, keep every branch at two reads or fewer, and let a successful
      // non-owner read prove existence before a promoted Admin's profile read.
      return isSignedIn()
        && (isAdminEmail()
            ? firestore.exists(messageConversation(convoId))
            : (firestore.get(messageConversation(convoId)).data.get('guest_uid', '') == request.auth.uid
                ? true
                : firestore.get(messageProfile(request.auth.uid)).data.get('role', 'guest') == 'admin'));
    }

    match /messageAttachments/{convoId}/{messageId} {
      allow read: if canAccessMessageImages(convoId);
      // Create-only makes an uncertain retry safe: metadata at the same stable
      // message id is reused, and nobody can replace an old message's image.
      allow create: if canAccessMessageImages(convoId)
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      // Admins may remove an orphan or perform retention cleanup. Guests
      // cannot erase an image from the shared record.
      allow delete: if isMessageAdmin();
      allow update: if false;
    }

    // P4 ENABLED (#14): payment proof uploads (screenshots/receipts of money
    // sent outside the system — GCash / bank transfer, ADR-0001).
    // Layout: /payments/{uid}/{bookingRef}/proof.jpg
    // - WRITE own-uid only, 5MB, image/* (guest uploads own proof only).
    // - READ own uid + the Admin allowlist (Admin verification in the mobile
    //   app). No public read.
    // - Deletes admit the Admin only: a delete carries no resource
    //   (request.resource == null).
    match /payments/{userId}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdminEmail());
      // `request.resource` is null on a delete, and reading a member of null is an
      // evaluation error rather than a false — so the size and content-type checks
      // are gated on the resource being there at all. Without the gate a Guest's
      // own `delete` tripped a null-value error instead of being decided by the
      // rule below it, which is how it was refused: by a crash, not a decision.
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow write: if isAdminEmail() && request.resource == null;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
