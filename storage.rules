rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // The Host, by the bootstrap allowlist (ADR-0005).
    //
    // Deliberately NOT the `profiles/{uid}` role that firestore.rules reads:
    // Storage rules would have to reach into Firestore to see it, and nothing in
    // either app writes to the two paths a Host-only Storage grant covers
    // (/gallery, /accommodations — site images, published by the owner). The one
    // Host-only read that matters, a Guest's government ID under /kyc, is keyed
    // by uid and listed here by the same allowlist. If the site ever grows an
    // image-publishing screen for a promoted Host, this becomes the place to
    // teach Storage about Profiles.
    // Keep this address in sync with hostEmails() in firestore.rules and
    // BOOTSTRAP_ROLES in src/lib/auth/profile.ts.
    function isHostEmail() {
      return isSignedIn()
        && request.auth.token.email in ['haciendadeluisiana@gmail.com'];
    }

    // Staff (the address firestore.rules keeps in staffEmails()) get NO storage
    // grants beyond public reads: /kyc holds government IDs (PII, RA 10173) and
    // stays Host-only on purpose. Staff read lock records from Firestore
    // access_logs, never from Storage — so that address appears nowhere in this
    // file, and the absence is the decision, not an oversight.

    // Public read for site assets, Host-only write (tightened P3:
    // was any-signed-in; site images are Host-published).
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isHostEmail()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /accommodations/{allPaths=**} {
      allow read: if true;
      allow write: if isHostEmail()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // User avatars (only the person themselves can write their own)
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024;
    }

    // P3 ENABLED: KYC ID + receipt uploads (sensitive PII, RA10173).
    // Layout: /kyc/{uid}/{bookingRef}/{id|receipt}.jpg
    // - WRITE own-uid only, 5MB, image/* (guest uploads own docs only).
    // - READ own uid + the Host allowlist (Host review). Staff are BLOCKED
    //   from IDs (locks-readonly ≠ ID review) — no Staff address appears in
    //   this file at all. No public read.
    // - Deletes/overwrites follow the same write gate (resubmit loop).
    match /kyc/{userId}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isHostEmail());
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
