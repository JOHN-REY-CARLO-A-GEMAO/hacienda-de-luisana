BOOKING_QUOTES_ENABLED=
QUOTE_TTL_MINUTES=
QUOTE_RATE_LIMIT_PER_MINUTE=

# --- Receipt OCR (ADR-0024) -------------------------------------------------
# Read by the `readReceiptText` callable. The Firebase CLI loads `functions/.env`
# at deploy time (gitignored); the function reads these with `process.env`.
# Deliberately NOT VITE_ variables — anything with that prefix is baked into the
# website bundle every Guest downloads.
#
#   cp functions/.env.example functions/.env
#   firebase deploy --only functions:readReceiptText
#
# A free key comes from https://ocr.space/ocrapi/freekey (25,000 reads/month,
# 500/day per IP, 1 MB per file). Leave it empty and the website keeps reading
# receipts in the Guest's browser with tesseract.js.
OCR_SPACE_API_KEY=

# 1 = fastest engine, 2 = best on screenshots (default), 3 = largest model.
OCR_SPACE_ENGINE=2

# OCR.space language code. The receipts this site sees are printed in English.
OCR_SPACE_LANGUAGE=eng

# Only needed for a PRO plan, whose endpoints differ from the free one.
# OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image

# Reads allowed per Guest/IP per minute, clamped 1–120.
# OCR_RATE_LIMIT_PER_MINUTE=10
