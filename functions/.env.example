# Disabled until separately approved staging/production rollout.
DISPUTES_ENABLED=false
DISPUTE_RETENTION_ENABLED=false
# Comma-separated Firebase UIDs; a designated user must ALSO be an active Admin.
DISPUTE_PRIVACY_ADMINS=
# Optional dedicated private evidence bucket; uniform access and non-public IAM are enforced.
DISPUTE_EVIDENCE_BUCKET=
# Approved private-network ClamAV service. PDFs fail closed when not configured.
CLAMAV_HOST=
CLAMAV_PORT=3310
