# Cloud Functions environment — copied by Firebase from `functions/.env` at deploy.
# Nothing here is committed with a real value; `.env` is gitignored by the root
# `.gitignore` (and by Firebase's own defaults).

# Turns the Booking quote/attestation callables on. See docs/quotes/IMPLEMENTATION.md.
BOOKING_QUOTES_ENABLED=

# How long a quote is honoured by `firestore.rules`, in minutes. Default 30.
QUOTE_TTL_MINUTES=

# Price requests per minute per Guest (the shared sliding window). Default 12.
QUOTE_RATE_LIMIT_PER_MINUTE=

# Salt for the hashed keys in `rate_limits`. Set it per deployment: the same salt
# everywhere makes the hashes comparable across projects, and no salt makes them
# a dictionary lookup. See functions/src/security/rateLimit.ts.
RATE_LIMIT_SALT=
