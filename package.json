{
  "name": "hacienda-de-luisana",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "lint": "tsc -b",
    "test": "node scripts/phase0/run.mjs web",
    "test:watch": "node scripts/phase0/run.mjs watch",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "emulators": "firebase emulators:start --project demo-hacienda --only auth,firestore,database,storage,ui --import ./emulator-data --export-on-exit",
    "test:rules": "node scripts/phase0/run.mjs rules",
    "test:emulator": "node scripts/phase0/run.mjs emulator",
    "test:e2e": "node scripts/phase0/run.mjs e2e",
    "test:safety": "node scripts/phase0/run.mjs safety",
    "test:phase0": "node scripts/phase0/run.mjs characterization",
    "test:invariants": "node scripts/phase0/run.mjs invariants",
    "test:emulator:invariants": "node scripts/phase0/run.mjs emulator-invariants",
    "test:emulator:auth": "node scripts/phase0/run.mjs emulator-auth",
    "test:supabase:rls": "node scripts/phase0/run.mjs supabase-rls",
    "test:flutter": "node scripts/phase0/run.mjs flutter",
    "test:flutter:invariants": "node scripts/phase0/run.mjs flutter-invariants",
    "test:flutter:analyze": "node scripts/phase0/run.mjs flutter-analyze",
    "test:qa:booking": "node scripts/phase0/run.mjs qa-booking",
    "test:qa:site": "node scripts/phase0/run.mjs qa-site",
    "test:qa:tutorial": "node scripts/phase0/run.mjs qa-tutorial",
    "check:phase0": "node scripts/phase0/run.mjs typecheck",
    "build:phase0": "node scripts/phase0/run.mjs build",
    "prepare:phase0:emulators": "node scripts/phase0/prepare-emulators.mjs",
    "prepare:phase0:java": "node scripts/phase0/prepare-java.mjs",
    "prepare:phase0:supabase-rls": "npm install --prefix .cache/phase0/tools --ignore-scripts --no-audit --no-fund --no-save @electric-sql/pglite@0.3.15"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "firebase": "^12.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^15.31.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.9.3",
    "vite": "^5.4.8",
    "vitest": "^3.2.7"
  }
}
