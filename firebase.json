{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/404.html"
      },
      {
        "source": "/guest/auth",
        "destination": "/404.html"
      },
      {
        "source": "/account",
        "destination": "/404.html"
      },
      {
        "source": "/messages",
        "destination": "/404.html"
      },
      {
        "source": "/book/pay",
        "destination": "/404.html"
      },
      {
        "source": "/booking/status",
        "destination": "/404.html"
      },
      {
        "source": "/review",
        "destination": "/404.html"
      },
      {
        "source": "/admin",
        "destination": "/404.html"
      },
      {
        "source": "/admin/**",
        "destination": "/404.html"
      },
      {
        "source": "/app",
        "destination": "/404.html"
      },
      {
        "source": "/app/**",
        "destination": "/404.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099,
      "host": "0.0.0.0"
    },
    "firestore": {
      "port": 8080,
      "host": "0.0.0.0"
    },
    "storage": {
      "port": 9199,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": true,
      "port": 4000,
      "host": "0.0.0.0"
    },
    "singleProjectMode": true,
    "database": {
      "port": 9000,
      "host": "0.0.0.0"
    },
    "functions": {
      "port": 5001,
      "host": "0.0.0.0"
    }
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "hacienda-de-luisana",
          "appId": "1:648433185:android:edcc607c8ea7a1af811d60",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "hacienda-de-luisana",
          "configurations": {
            "android": "1:648433185:android:edcc607c8ea7a1af811d60",
            "ios": "1:648433185:ios:20b6b31ff6c9885f811d60"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "disputes",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "*.log"
      ]
    }
  ]
}
