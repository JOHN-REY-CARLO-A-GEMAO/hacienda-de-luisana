# Set to "true" to deploy the quoteBooking / verifyBookingMoney callables.
# Required BEFORE flipping site_config/booking.quotes_required to true in
# Firestore, otherwise every online Booking is refused.
BOOKING_QUOTES_ENABLED=true
# How long a price is honoured, in minutes (clamped 1–240, default 30).
QUOTE_TTL_MINUTES=30
# Mint limit per identity per minute (clamped to at least 1).
QUOTE_RATE_LIMIT_PER_MINUTE=12

# --- Receipt OCR (ADR-0024) -------------------------------------------------
# The OCR.space key belongs to the `readReceiptText` function, NOT to the
# website. Put it in `functions/.env` (gitignored) and never prefix it with
# VITE_: a VITE_ variable is baked into the bundle every Guest downloads.
# Get a free key at https://ocr.space/ocrapi/freekey
# OCR_SPACE_API_KEY=
# OCR_SPACE_ENGINE=2            # 1 = fast, 2 = better on screenshots, 3 = largest
# OCR_SPACE_LANGUAGE=eng
# OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image  # set the PRO endpoint if you buy one
# OCR_RATE_LIMIT_PER_MINUTE=10  # per Guest/IP, clamped 1–120

# Set to `ocrspace` to read a screenshot with OCR.space first and keep
# tesseract.js only as the fallback. Leave unset (or empty) and every receipt is
# read inside the Guest's browser, with nothing leaving the device.
VITE_RECEIPT_OCR_CLOUD=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_USE_FIREBASE_EMULATORS=
# Cloudflare Turnstile site key (public). Set this to render the CAPTCHA widget
# on the auth forms. Leave unset and the forms work without it.
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
