VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Supabase Storage — payment proof uploads (ADR-0011, bucket `payment-proofs`).
# With either value missing the site runs in demo mode and proofs stay in this
# browser's localStorage instead of reaching the cloud.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Practice database: talk to the local Emulator Suite instead of the live
# project (same SDK, same firestore.rules/storage.rules, zero quota, uploads
# included). Requires .env.local to hold real-looking Firebase keys AND:
#   1. npm run emulators   (Auth :9099, Firestore :8080, Storage :9199, UI :4000)
#   2. npm run dev          (this app, http://localhost:3000)
# Anything else — absent, empty, 'false' — talks to the live project.
VITE_USE_FIREBASE_EMULATORS=