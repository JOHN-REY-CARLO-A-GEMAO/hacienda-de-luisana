VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Realtime Database — the ephemeral live-location stream (ADR-0013).
#
# Two steps, in this order. Neither value below is derivable from this file:
#
#   1. The Realtime Database must EXIST in the live project. Create it in the
#      Firebase console (Build -> Realtime Database). Until it does there is no
#      URL to copy, and a filled-in guess would fail at runtime while looking
#      configured.
#   2. Copy its URL. The shape is
#        https://<projectId>-default-rtdb.<region>.firebasedatabase.app
#      so with VITE_FIREBASE_PROJECT_ID above it reads
#        https://<that-project-id>-default-rtdb.<region>.firebasedatabase.app
#      `<region>` is whichever region the console created the database in, so it
#      is copied rather than assumed.
#
# Also set the same URL as `databaseURL` in `lib/firebase_options.dart`, which is
# the Admin half of the same feature.
#
# Left empty on purpose: with it empty the chat's "Live Location" control is
# disabled and says why (hasRealtimeDatabaseConfig() is false), and nothing else
# in the site changes. Demo mode is unaffected.
VITE_FIREBASE_DATABASE_URL=

# Supabase Storage — payment proof uploads (ADR-0011, bucket `payment-proofs`).
# With either value missing the site runs in demo mode and proofs stay in this
# browser's localStorage instead of reaching the cloud.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Practice database: talk to the local Emulator Suite instead of the live
# project (same SDK, same firestore.rules/storage.rules, zero quota, uploads
# included). Requires .env.local to hold real-looking Firebase keys AND:
#   1. npm run emulators   (Auth :9099, Firestore :8080, Storage :9199, UI :4000)
#   2. npm run dev          (this app, http://localhost:3000)
# Anything else — absent, empty, 'false' — talks to the live project.
VITE_USE_FIREBASE_EMULATORS=