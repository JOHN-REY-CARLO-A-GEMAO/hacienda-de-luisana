# Set to "true" to deploy the quoteBooking / verifyBookingMoney callables.
# Required BEFORE flipping site_config/booking.quotes_required to true in
# Firestore, otherwise every online Booking is refused.
BOOKING_QUOTES_ENABLED=true
# How long a price is honoured, in minutes (clamped 1–240, default 30).
QUOTE_TTL_MINUTES=30
# Mint limit per identity per minute (clamped to at least 1).
QUOTE_RATE_LIMIT_PER_MINUTE=12
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_USE_FIREBASE_EMULATORS=
# Public Cloudflare Worker base URL for booking endpoints, e.g.
# https://hacienda-de-luisana-api.<account-subdomain>.workers.dev
# Leave unset to keep the Firebase callable/Spark fallback path.
VITE_WORKER_API_URL=
# Cloudflare Turnstile site key (public). Set this to render the CAPTCHA widget
# on the auth forms. Leave unset and the forms work without it.
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=

# CARTO basemap key for the Admin app (scripts/flutter-web.mjs reads this and
# passes it to Flutter as --dart-define). Free: https://carto.com/basemaps/apikey/
CARTO_KEY=
