app.*.map.json

# Pub lock — COMMITTED for the app, so a build is reproducible.
#
# The Flutter template ignores `pubspec.lock` because a *library* should not pin
# its consumers' dependency versions. This is the Admin app, which pins them: with
# the lock ignored, `flutter pub get` on a fresh machine can resolve the Firebase
# plugins to different majors than the ones the code was fixed against, which is
# how `Database` became `FirebaseDatabase` in the first place.
# The Flutter template's nested-path ignore is kept below, where it belongs.
hacienda_flutter/pubspec.lock

# Misc project clutter (do not commit)
hacienda_flutter/
.scratch/
image-search/
preview/
dist/
.idea/

# Local Firebase Android config (per-machine, never commit)
android/app/google-services.json

# Real-browser QA output (docs/qa/*.mjs) — screenshots and reports are local evidence, never committed
docs/qa/screenshots/
